+using System;
+using System.Linq;
+using Apaleo.Api;
+using Microsoft.AspNetCore.Authorization;
+using Xunit;
+
+namespace Apaleo.Api.Tests.Architecture;
+
+public sealed class AuthorizationArchitectureTest
+{
+    private const string OpaNamespace = "Apaleo.Api.Infrastructure.Authorization";
+
+    [Fact]
+    public void AuthorizationPolicyTypesMustLiveInOpaLayer()
+    {
+        var offenders = typeof(Startup).Assembly.DefinedTypes
+            .Where(IsAuthorizationPolicyType)
+            .Where(type => type.Namespace is null || (
+                type.Namespace != OpaNamespace
+                && !type.Namespace.StartsWith(OpaNamespace + ".", StringComparison.Ordinal)))
+            .Select(type => type.FullName)
+            .OrderBy(name => name)
+            .ToArray();
+
+        Assert.True(
+            offenders.Length == 0,
+            "Authorization policy belongs in the OPA integration layer: "
+            + string.Join(", ", offenders));
+    }
+
+    private static bool IsAuthorizationPolicyType(Type type) =>
+        typeof(IAuthorizationHandler).IsAssignableFrom(type)
+        || typeof(IAuthorizationRequirement).IsAssignableFrom(type)
+        || DerivesFromOpenGeneric(type, typeof(AuthorizationHandler<>));
+
+    private static bool DerivesFromOpenGeneric(Type type, Type openGeneric)
+    {
+        for (var current = type.BaseType; current is not null; current = current.BaseType)
+        {
+            if (current.IsGenericType && current.GetGenericTypeDefinition() == openGeneric)
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
